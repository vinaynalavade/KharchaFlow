<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Strictly prevent financial records, database, and preferences from cloud backup -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>

    <!-- Allow direct local device-to-device migration when user transfers data to a new phone -->
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
