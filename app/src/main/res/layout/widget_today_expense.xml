<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_widget_card">

    <!-- Top Header: Logo / Branding, "Today" Pill, & Refresh Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_kharchaflow_logo"
                android:contentDescription="KharchaFlow"
                android:scaleType="fitCenter"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KharchaFlow"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_brand"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_pill_text"
            android:background="@drawable/bg_widget_stat_pill"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/today_widget_btn_refresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Refresh Widget"
            android:padding="2dp" />
    </LinearLayout>

    <!-- Spacer: uses FrameLayout (RemoteViews-compatible) instead of bare View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Label: TODAY'S EXPENSE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TODAY&apos;S EXPENSE"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_secondary"
        android:letterSpacing="0.08" />

    <!-- Amount: Primary display -->
    <TextView
        android:id="@+id/today_widget_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0.00"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/widget_expense_text"
        android:includeFontPadding="false"
        android:layout_marginTop="2dp" />

    <!-- Bottom Spacer: uses FrameLayout (RemoteViews-compatible) instead of bare View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="6dp" />

</LinearLayout>
