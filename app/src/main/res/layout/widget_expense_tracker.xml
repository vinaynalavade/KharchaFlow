<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_widget_card">

    <!-- Brand Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KHARCHAFLOW"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#059669"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_today_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today: - ₹0.00"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:background="@drawable/bg_widget_stat_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Main Current Balance Display -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TOTAL BALANCE"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#94A3B8"
        android:letterSpacing="0.05"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/widget_total_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹0.00"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:includeFontPadding="false"
        android:layout_marginTop="1dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:weightSum="2">

        <Button
            android:id="@+id/widget_btn_add_expense"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="+ Expense"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_widget_btn_expense"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@null"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/widget_btn_add_income"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="+ Income"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_widget_btn_income"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@null"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
